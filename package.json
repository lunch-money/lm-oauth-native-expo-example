{
  "name": "lm-oauth-native-expo-example",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "EXPO_NO_QR_CODE=1 expo start --dev-client --ios",
    "ios:build": "expo run:ios --no-bundler",
    "ios:metro": "EXPO_NO_QR_CODE=1 expo start --dev-client",
    "android": "expo run:android",
    "build": "npm run export:ios && npm run export:android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx src tests --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "expo": "~57.0.10",
    "expo-auth-session": "~57.0.6",
    "expo-build-properties": "~57.0.21",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "jest-expo": "57.0.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
